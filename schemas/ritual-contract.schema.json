{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vesper.local/schemas/ritual-contract.schema.json",
  "type": "object",
  "required": ["phenomenon", "instrument", "dataSource", "inputMeaning", "dependentAction", "risk", "logicalOperation", "output", "physicalConsequence", "grimoireKnowledge"],
  "properties": {
    "phenomenon": { "type": "string", "minLength": 1 },
    "instrument": { "type": "string", "minLength": 1 },
    "dataSource": { "type": "string", "minLength": 1 },
    "inputMeaning": { "type": "string", "minLength": 1 },
    "dependentAction": { "type": "string", "minLength": 1 },
    "risk": { "type": "string", "minLength": 1 },
    "logicalOperation": { "type": "string", "minLength": 1 },
    "output": { "type": "string", "minLength": 1 },
    "physicalConsequence": { "type": "string", "minLength": 1 },
    "grimoireKnowledge": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
